FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=mysql+pymysql://campus_user:campus_password@localhost/campus_lost_found
UPLOAD_FOLDER=backend/uploads
MAX_UPLOAD_BYTES=5242880
CORS_ORIGINS=http://localhost:5500
# Lax works for local development where frontend and API share localhost.
# Set to None (and SESSION_COOKIE_SECURE=true) if the frontend is ever
# deployed on a different hostname than the API, otherwise the session
# cookie will silently stop being sent on cross-site requests.
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false
